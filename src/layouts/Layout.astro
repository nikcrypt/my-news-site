---
// src/layouts/Layout.astro
import '../styles/global.css';
import { pb } from '../lib/pocketbase';

const { title = 'My News Site' } = Astro.props;
const pathname = Astro.url.pathname;

interface Category {
  id: string;
  name: string;
  slug: string;
  sort?: number;
  parent?: string;
}

let allCategories: Category[] = [];
let topCategories: Category[] = [];

try {
  allCategories = await pb.collection('categories').getFullList({
    sort: '+sort,+name',
    fields: 'id,name,slug,sort,parent',
  });

  topCategories = allCategories.filter(cat => !cat.parent);
} catch (err) {
  console.error('[Layout] Category fetch failed:', err);
}
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="Latest news and updates" />
    <!-- Google Fonts for a nice serif font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
  </head>
  
  <body class="min-h-screen bg-base-200 text-base-content antialiased">
    <header class="navbar bg-base-100 shadow-md sticky top-0 z-50">
      <!-- Logo left - takes equal space, pushes center to middle -->
      <div class="navbar-start flex-1">
        <a href="/" class="text-2xl font-bold flex items-center gap-2">
          <!-- Newspaper icon -->
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-primary">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 7.5h1.5m-1.5 3h1.5m-7.5 3h7.5m-7.5 3h7.5m3-9h3.375c.621 0 1.125.504 1.125 1.125V18a2.25 2.25 0 01-2.25 2.25M16.5 7.5V18a2.25 2.25 0 002.25 2.25M16.5 7.5V4.875c0-.621-.504-1.125-1.125-1.125H4.125C3.504 3.75 3 4.254 3 4.875V18a2.25 2.25 0 002.25 2.25h13.5M6 7.5h3v3H6v-3z" />
          </svg>
          <!-- Site title with gradient -->
          <span class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent" style="font-family: 'Playfair Display', serif;">
            The Great News
          </span>
        </a>
      </div>

      <!-- Categories - center, no flex growth -->
      <div class="navbar-center hidden lg:flex flex-none">
        <ul class="menu menu-horizontal px-1">
          <li>
            <a href="/" class={pathname === '/' ? 'active' : ''}>Home</a>
          </li>

          {topCategories.map((cat) => {
            const subs = allCategories.filter(sub => sub.parent === cat.id);
            const hasSubs = subs.length > 0;
            const isActive = pathname === `/category/${cat.slug}`;

            if (hasSubs) {
              return (
                <li class="dropdown dropdown-hover">
                  <div tabindex="0" role="button" class={isActive ? 'active' : ''}>
                    {cat.name}
                    <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </div>
                  <ul tabindex="0" class="menu dropdown-content bg-base-100 rounded-box z-[1] w-52 p-2 shadow mt-1">
                    {subs.map((sub) => (
                      <li>
                        <a href={`/category/${sub.slug}`}>{sub.name}</a>
                      </li>
                    ))}
                  </ul>
                </li>
              );
            }

            return (
              <li>
                <a href={`/category/${cat.slug}`} class={isActive ? 'active' : ''}>
                  {cat.name}
                </a>
              </li>
            );
          })}

          <li>
            <a href="/about" class={pathname === '/about' ? 'active' : ''}>About</a>
          </li>
        </ul>
      </div>

      <!-- Search + Mobile menu - right, takes equal space, content aligned end -->
      <div class="navbar-end flex-1 flex gap-2 justify-end">
        <!-- Desktop search bar (hidden on mobile) -->
        <form class="join hidden lg:flex">
          <input 
            type="text" 
            placeholder="Search articles..." 
            class="input input-bordered join-item w-48 lg:w-64" 
            aria-label="Search"
          />
          <button class="btn btn-ghost join-item" type="submit" aria-label="Submit search">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </button>
        </form>

        <!-- Mobile search icon (visible on small screens) -->
        <button class="btn btn-ghost btn-circle lg:hidden" aria-label="Search">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </button>

        <!-- Mobile hamburger -->
        <div class="dropdown dropdown-end lg:hidden">
          <label tabindex="0" class="btn btn-ghost btn-circle" aria-label="Menu">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </label>
          <ul tabindex="0" class="menu menu-sm dropdown-content mt-3 z-[1] p-2 shadow bg-base-100 rounded-box w-52">
            <li><a href="/">Home</a></li>

            {topCategories.map((cat) => {
              const subs = allCategories.filter(sub => sub.parent === cat.id);
              const hasSubs = subs.length > 0;

              return (
                <>
                  <li>
                    <a href={`/category/${cat.slug}`}>{cat.name}</a>
                  </li>
                  {hasSubs && (
                    <li>
                      <ul class="menu menu-sm bg-base-200 rounded-box ml-4 mt-1">
                        {subs.map((sub) => (
                          <li>
                            <a href={`/category/${sub.slug}`}>↳ {sub.name}</a>
                          </li>
                        ))}
                      </ul>
                    </li>
                  )}
                </>
              );
            })}

            <li><a href="/about">About</a></li>
          </ul>
        </div>
      </div>
    </header>

    <main class="container mx-auto px-4 py-8 md:py-12">
      <slot />
    </main>

    <footer class="footer footer-center p-10 bg-base-300 text-base-content">
      <div>
        <p>© {new Date().getFullYear()} {title}. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>