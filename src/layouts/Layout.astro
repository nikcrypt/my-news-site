---
// src/layouts/Layout.astro
import '../styles/global.css';  // ← this makes Tailwind/DaisyUI available on all pages

const { title = 'My News Site' } = Astro.props;
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="Latest news and updates" />
    
    <!-- Optional: favicon, meta tags, etc. -->
    <!-- <link rel="icon" type="image/svg+xml" href="/favicon.svg" /> -->
  </head>
  
  <body class="min-h-screen bg-base-200 text-base-content antialiased">
    <!-- Optional header/navbar -->
    <header class="navbar bg-base-100 shadow-md">
      <div class="container mx-auto px-4 py-4">
        <a href="/" class="text-2xl font-bold text-primary">
          News Site
        </a>
        <!-- You can add nav links here later -->
      </div>
    </header>

    <!-- Main content slot -->
    <main class="container mx-auto px-4 py-8 md:py-12">
      <slot />  <!-- ← all page content (index.astro, [slug].astro, etc.) goes here -->
    </main>

    <!-- Optional footer -->
    <footer class="footer footer-center p-10 bg-base-300 text-base-content">
      <div>
        <p>© {new Date().getFullYear()} My News Site. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>