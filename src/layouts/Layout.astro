---
// src/layouts/Layout.astro
import '../styles/global.css';

const { title = 'My News Site' } = Astro.props;
const pathname = Astro.url.pathname; // for active link highlighting
---
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="Latest news and updates" />
  </head>
  
  <body class="min-h-screen bg-base-200 text-base-content antialiased">
    <!-- Sticky Navbar -->
    <header class="navbar bg-base-100 shadow-md sticky top-0 z-50">
      <div class="container mx-auto px-4">
        <!-- Left side: logo -->
        <div class="navbar-start">
          <a href="/" class="text-2xl font-bold text-primary">
            {title}
          </a>
        </div>

        <!-- Center: desktop menu (hidden on mobile) -->
        <div class="navbar-center hidden lg:flex">
          <ul class="menu menu-horizontal px-1">
            <li>
              <a href="/" class={pathname === '/' ? 'active' : ''}>Home</a>
            </li>
            <li>
              <a href="/category/politics" class={pathname.startsWith('/category/politics') ? 'active' : ''}>Politics</a>
            </li>
            <li>
              <a href="/category/tech" class={pathname.startsWith('/category/tech') ? 'active' : ''}>Tech</a>
            </li>
            <li>
              <a href="/category/sports" class={pathname.startsWith('/category/sports') ? 'active' : ''}>Sports</a>
            </li>
            <li>
              <a href="/about" class={pathname === '/about' ? 'active' : ''}>About</a>
            </li>
          </ul>
        </div>

        <!-- Right side: search + mobile dropdown -->
        <div class="navbar-end">
          <!-- Search button (optional) -->
          <button class="btn btn-ghost btn-circle" aria-label="Search">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </button>

          <!-- Mobile dropdown (visible only on small screens) -->
          <div class="dropdown dropdown-end lg:hidden">
            <label tabindex="0" class="btn btn-ghost btn-circle" aria-label="Menu">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
            </label>
            <ul tabindex="0" class="menu menu-sm dropdown-content mt-3 z-[1] p-2 shadow bg-base-100 rounded-box w-52">
              <li><a href="/">Home</a></li>
              <li><a href="/category/politics">Politics</a></li>
              <li><a href="/category/tech">Tech</a></li>
              <li><a href="/category/sports">Sports</a></li>
              <li><a href="/about">About</a></li>
            </ul>
          </div>
        </div>
      </div>
    </header>

    <!-- Main content slot -->
    <main class="container mx-auto px-4 py-8 md:py-12">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="footer footer-center p-10 bg-base-300 text-base-content">
      <div>
        <p>© {new Date().getFullYear()} {title}. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>
