---
import Layout from '../layouts/Layout.astro';

export const prerender = false;
---

<Layout title="Author Dashboard">
  <main class="max-w-4xl mx-auto py-12 px-4">
    <div id="auth-container" class="card bg-base-100 dark:bg-base-300 shadow-2xl p-8 min-h-[60vh] flex items-center justify-center">
      <p class="text-xl opacity-70">Loading...</p>
    </div>
  </main>

  <script>
    import PocketBase from 'pocketbase';

    document.addEventListener('DOMContentLoaded', () => {
      const pb = new PocketBase('http://127.0.0.1:8090');
      const container = document.getElementById('auth-container');

      if (!container) {
        console.error('Container not found');
        return;
      }

      // 1. Check if already logged in
      if (pb.authStore.isValid) {
        container.innerHTML = `
          <div class="text-center">
            <h1 class="text-4xl font-bold mb-6">Welcome back!</h1>
            <p class="text-lg mb-6">Redirecting to editor...</p>
            <span class="loading loading-spinner loading-lg"></span>
          </div>
        `;
        setTimeout(() => {
          window.location.href = '/dashboard/editor';
        }, 1200);
        return;
      }

      // 2. Show login form
      container.innerHTML = `
        <div class="w-full max-w-md">
          <h1 class="text-3xl font-bold mb-8 text-center">Author Login</h1>

          <form id="login-form" class="space-y-6">
            <div class="form-control">
              <label for="email" class="label">
                <span class="label-text">Email</span>
              </label>
              <input type="email" id="email" name="email" class="input input-bordered w-full" placeholder="Email" required autocomplete="email" />
            </div>

            <div class="form-control">
              <label for="password" class="label">
                <span class="label-text">Password</span>
              </label>
              <input type="password" id="password" name="password" class="input input-bordered w-full" placeholder="Password" required autocomplete="current-password" />
            </div>

            <button type="submit" class="btn btn-primary w-full">Login</button>
          </form>

          <p id="login-error" class="text-error mt-4 text-center min-h-[1.5rem]"></p>
          <p id="login-success" class="text-success mt-4 text-center hidden">Success! Redirecting...</p>
        </div>
      `;

      const form = document.getElementById('login-form');
      const errorEl = document.getElementById('login-error');
      const successEl = document.getElementById('login-success');

      if (!form) {
        console.error('Form not found');
        return;
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const email = document.getElementById('email')?.value?.trim();
        const password = document.getElementById('password')?.value?.trim();

        if (!email || !password) {
          if (errorEl) errorEl.textContent = 'Please enter email and password';
          return;
        }

        try {
          errorEl.textContent = '';
          successEl.classList.remove('hidden');

          await pb.collection('authors').authWithPassword(email, password);

          document.cookie = `pb_auth=${JSON.stringify(pb.authStore.exportToCookie())}; path=/; max-age=86400; SameSite=Strict`;

          successEl.textContent = 'Login successful! Redirecting...';
          setTimeout(() => {
            window.location.href = '/dashboard/editor';
          }, 1200);
        } catch (err) {
          let msg = 'Login failed';
          if (err instanceof Error) msg = err.message;
          errorEl.textContent = msg;
          successEl.classList.add('hidden');
          console.error(err);
        }
      });
    });
  </script>
</Layout>