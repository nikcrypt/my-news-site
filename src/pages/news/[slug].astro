---
// src/pages/news/[slug].astro
import { pb } from '../../lib/pb';
import Layout from '../../layouts/Layout.astro';

export const prerender = false;

// ------------------------------------------------------------
// 1. getStaticPaths() – with logging
// ------------------------------------------------------------
export async function getStaticPaths() {
  try {
    console.log('🔍 Fetching articles for static paths...');
    const articles = await pb.collection('articles').getFullList({
      filter: 'status = "published" && published_at <= @now',
      fields: 'id,slug',
    });

    console.log(`Found ${articles.length} published articles`);

    const valid = articles.filter(a => {
      const s = a.slug?.trim();
      if (!s || s.length < 3) {
        console.warn(`Skipping article ${a.id} - invalid slug: "${a.slug}"`);
        return false;
      }
      return true;
    });

    console.log(`Generated ${valid.length} valid paths`);

    return valid.map(a => ({
      params: { slug: a.slug },
    }));
  } catch (err) {
    console.error('getStaticPaths failed:', err.message || err);
    return [];
  }
}

// ------------------------------------------------------------
// 2. Get current slug from URL params
// ------------------------------------------------------------
const { slug } = Astro.params;

// ------------------------------------------------------------
// 3. Fetch article and related data
// ------------------------------------------------------------
let article = null;
let comments = [];
let averageRating = 0;
let totalRatings = 0;
let favoriteCount = 0;

try {
  article = await pb.collection('articles').getFirstListItem(
    `slug = "${slug}" && status = "published" && published_at <= @now`,
    { expand: 'category,author,tags' }
  );

  comments = await pb.collection('comments').getFullList({
    filter: `article = "${article.id}"`,
    sort: '-created',
  });

  const ratings = await pb.collection('ratings').getFullList({
    filter: `article = "${article.id}"`,
  });
  totalRatings = ratings.length;
  if (totalRatings > 0) {
    const sum = ratings.reduce((acc, r) => acc + r.rating, 0);
    averageRating = sum / totalRatings;
  }

  const favorites = await pb.collection('favorites').getFullList({
    filter: `article = "${article.id}"`,
  });
  favoriteCount = favorites.length;
} catch (err) {
  console.error('Fetch error:', err);
  return Astro.redirect('/404');
}

let relatedArticles: any = { items: [] };

if (article?.expand?.category?.id) {
  try {
    const res = await pb.collection('articles').getList(1, 6, {
      filter: `category = "${article.expand.category.id}" && id != "${article.id}" && status = "published" && published_at <= @now`,
      sort: '-published_at',
      expand: 'category', // expand category so we can show its name
      // ⬇️ Removed `fields` – the record now includes all needed properties (collectionId, id, cover, etc.)
    });
    relatedArticles = res;
  } catch (err) {
    console.error('Related articles error:', err);
  }
}

// ------------------------------------------------------------
// 4. Format date helper
// ------------------------------------------------------------
const formatDate = (dateStr: string) => {
  return new Date(dateStr).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};

// ------------------------------------------------------------
// 5. Featured image
// ------------------------------------------------------------
const coverFilename = article?.cover;
let featuredImage = null;
if (coverFilename) {
  featuredImage = pb.files.getURL(article, coverFilename, { thumb: '1200x0' });
}
const fallbackImage = 'https://images.unsplash.com/photo-1504711434969-e33886168f5c?w=1200&auto=format&fit=crop&q=80';

// ------------------------------------------------------------
// 6. Author avatar
// ------------------------------------------------------------
const authorAvatar = article.expand?.author?.avatar
  ? pb.files.getURL(article.expand.author, article.expand.author.avatar, {
      thumb: '80x80',
    })
  : null;
---

<Layout title={article.title}>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-16">
    <!-- Title -->
    <h1 class="text-4xl md:text-5xl font-bold mb-6">{article.title}</h1>

    <!-- Featured Image -->
    <figure class="mb-8 -mx-4 sm:-mx-6 lg:-mx-8">
      <img
        src={featuredImage || fallbackImage}
        alt={article.title}
        class="w-full h-auto rounded-none sm:rounded-2xl shadow-2xl object-cover aspect-[16/9]"
        loading="eager"
        width="1200"
        height="675"
      />
    </figure>

    <!-- Meta bar -->
    <div class="flex flex-wrap items-center justify-between gap-4 mb-10">
      <div class="flex flex-wrap items-center gap-4">
        {article.expand?.category?.name && (
          <span class="badge badge-primary badge-outline uppercase text-xs px-3 py-1">
            {article.expand.category.name}
          </span>
        )}

        {article.expand?.author?.name && (
          <div class="flex items-center gap-3">
            {authorAvatar && (
              <div class="avatar">
                <div class="w-10 rounded-full ring ring-primary ring-offset-base-100 ring-offset-2">
                  <img src={authorAvatar} alt={article.expand.author.name} />
                </div>
              </div>
            )}
            <span class="font-medium">By {article.expand.author.name}</span>
          </div>
        )}

        <time class="text-base-content/70">
          {formatDate(article.published_at)}
        </time>
      </div>

      <!-- Rating and favorite -->
      <div class="flex items-center gap-4" id="meta-actions">
        <div
          class="flex items-center gap-1 tooltip"
          data-tip={`${averageRating.toFixed(1)} (${totalRatings} ratings)`}
        >
          <div class="rating rating-sm rating-half">
            {[1, 2, 3, 4, 5].map((star) => (
              <input
                type="radio"
                name="rating-10"
                class={`mask mask-star-2 mask-half-${star % 2 === 1 ? '1' : '2'} bg-orange-400`}
                disabled
                checked={Math.round(averageRating * 2) === star}
              />
            ))}
          </div>
          <span class="text-sm font-medium">{averageRating.toFixed(1)}</span>
        </div>

        <button
          class="btn btn-ghost btn-sm gap-2 favorite-btn"
          data-article-id={article.id}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-5 h-5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"
            />
          </svg>
          <span class="favorite-count">{favoriteCount}</span>
        </button>
      </div>
    </div>

    <!-- Article content -->
    <div
      class="article-body prose prose-lg lg:prose-xl dark:prose-invert prose-headings:font-bold prose-a:text-primary max-w-none"
      set:html={article.body}
    />

    <style is:global>
      /* (your existing styles – unchanged) */
    </style>

    <!-- Tags -->
    {article.expand?.tags?.length > 0 && (
      <div class="mt-12 flex flex-wrap gap-2">
        {article.expand.tags.map((tag) => (
          <span class="badge badge-outline badge-secondary text-sm">
            #{tag.name}
          </span>
        ))}
      </div>
    )}

    <!-- Comments Section -->
    <section class="mt-16 border-t pt-10">
      <h2 class="text-2xl font-bold mb-6">Comments ({comments.length})</h2>

      <div class="space-y-6 mb-10" id="comments-list">
        {comments.length > 0 ? (
          comments.map((comment) => (
            <div class="bg-base-100 p-4 rounded-lg shadow-sm">
              <div class="flex items-center gap-3 mb-2">
                <div class="font-semibold">{comment.user}</div>
                <div class="text-xs opacity-60">{formatDate(comment.created)}</div>
              </div>
              <p class="text-base-content/80">{comment.content}</p>
            </div>
          ))
        ) : (
          <p class="opacity-70 italic">
            No comments yet. Be the first to comment!
          </p>
        )}
      </div>

      <form id="comment-form" class="bg-base-100 p-6 rounded-xl shadow-sm">
        <h3 class="text-lg font-semibold mb-4">Leave a comment</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
          <input
            type="text"
            name="name"
            placeholder="Your name *"
            required
            class="input input-bordered w-full"
          />
          <input
            type="email"
            name="email"
            placeholder="Your email (optional)"
            class="input input-bordered w-full"
          />
        </div>
        <textarea
          name="content"
          rows="4"
          placeholder="Your comment *"
          required
          class="textarea textarea-bordered w-full mb-4"
        ></textarea>
        <input type="hidden" name="articleId" value={article.id} />
        <button type="submit" class="btn btn-primary">Post Comment</button>
        <div id="comment-status" class="mt-2"></div>
      </form>
    </section>

    <!-- Rating Section -->
    <section class="mt-12 border-t pt-10">
      <h2 class="text-2xl font-bold mb-4">Rate this article</h2>
      <div class="flex items-center gap-6">
        <div class="rating rating-lg rating-half" id="rating-stars">
          <input type="radio" name="rating-5" class="rating-hidden" />
          {[1, 2, 3, 4, 5].map((star) => (
            <>
              <input
                type="radio"
                name="rating-5"
                class="mask mask-star-2 mask-half-1 bg-orange-400"
                value={star - 0.5}
              />
              <input
                type="radio"
                name="rating-5"
                class="mask mask-star-2 mask-half-2 bg-orange-400"
                value={star}
              />
            </>
          ))}
        </div>
        <button
          id="submit-rating"
          class="btn btn-outline btn-primary"
          data-article-id={article.id}
        >
          Submit Rating
        </button>
      </div>
      <div id="rating-status" class="mt-2 text-sm"></div>
    </section>
  </article>

  <!-- ========== RELATED ARTICLES (now inside Layout) ========== -->
  {
    relatedArticles?.items?.length > 0 && (
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-16 border-t pt-10">
        <h2 class="text-2xl font-bold mb-6">More from this category</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {relatedArticles.items.map((rel: any) => {
            let relCover = fallbackImage;

            // Now the record has all fields, including collectionId – getURL will work
            if (rel.cover) {
              try {
                relCover = pb.files.getURL(rel, rel.cover, { thumb: '600x400' });
              } catch (e) {
                console.error('getURL failed for article', rel.id, e);
              }
            }

            return (
              <a
                href={`/news/${rel.slug}`}
                class="group block bg-base-100 rounded-xl overflow-hidden shadow-md hover:shadow-lg transition-shadow"
              >
                <figure class="aspect-[5/3] overflow-hidden bg-gray-200">
                  <img
                    src={relCover}
                    alt={rel.title || 'Article image'}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    width="600"
                    height="360"
                    loading="lazy"
                    onerror="this.src='{fallbackImage}'; this.alt='Fallback image';"
                  />
                </figure>
                <div class="p-5">
                  {rel.expand?.category?.name && (
                    <span class="badge badge-outline badge-sm mb-2 inline-block">
                      {rel.expand.category.name}
                    </span>
                  )}
                  <h3 class="font-semibold text-lg line-clamp-2 group-hover:text-primary transition-colors">
                    {rel.title || 'Untitled'}
                  </h3>
                  <time class="text-sm opacity-70 mt-2 block">
                    {formatDate(rel.published_at)}
                  </time>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )
  }

  <!-- ========== FOOTER (added to ensure it's at the bottom) ========== -->
  <footer class="bg-base-200 border-t mt-16 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-base-content/60">
      <p>&copy; {new Date().getFullYear()} Your Site Name. All rights reserved.</p>
    </div>
  </footer>
</Layout>

<!-- Client‑side interactivity – now inside Layout (Astro will hoist it correctly) -->
<script>
  import { pb } from '../../lib/pb';
  // Helper to get elements with better typing
  const articleIdInput = document.querySelector<HTMLInputElement>('input[name="articleId"]');
  const articleId = articleIdInput?.value || '';

  // Favorite button (unchanged)
  const favoriteBtn = document.querySelector<HTMLButtonElement>('.favorite-btn');
  if (favoriteBtn) {
    favoriteBtn.addEventListener('click', async () => {
      alert('Favorite toggled (backend needed)');
    });
  }

  // ───────────────────────────────────────────────
  // Comment form – direct PocketBase create
  // ───────────────────────────────────────────────
  const commentFormElement = document.getElementById('comment-form');
  if (commentFormElement instanceof HTMLFormElement) {
    commentFormElement.addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(commentFormElement);
      const name    = (formData.get('name') as string)?.trim()    || 'Anonymous';
      const email   = (formData.get('email') as string)?.trim()   || '';
      const content = (formData.get('content') as string)?.trim() || '';

      if (!content) {
        alert('Please write a comment.');
        return;
      }

      const statusDiv = document.getElementById('comment-status');
      if (statusDiv) {
        statusDiv.textContent = 'Submitting comment...';
        statusDiv.className = 'mt-2 text-info';
      }

      try {
        await pb.collection('comments').create({
          article: articleId,
          user:    name,
          content: content,
          status:  'pending',
          // email:   email,   // add this line only if you have "email" field in comments collection
        });

        if (statusDiv) {
          statusDiv.textContent = 'Thank you! Your comment is awaiting approval.';
          statusDiv.className = 'mt-2 text-success';
        }

        commentFormElement.reset(); // now safe – we checked instanceof HTMLFormElement
      } catch (err: unknown) {
        console.error('Comment submission failed:', err);

        const errorMessage = err instanceof Error 
          ? err.message 
          : 'Unknown error occurred';

        if (statusDiv) {
          statusDiv.textContent = errorMessage.includes('403')
            ? 'Submission blocked – check PocketBase create rule'
            : `Error: ${errorMessage}`;
          statusDiv.className = 'mt-2 text-error';
        }
      }
    });
  }

  // ───────────────────────────────────────────────
  // Rating submission – direct PocketBase create
  // ───────────────────────────────────────────────
  const submitRatingBtn = document.getElementById('submit-rating');
  if (submitRatingBtn instanceof HTMLButtonElement) {
    submitRatingBtn.addEventListener('click', async () => {
      const selected = document.querySelector<HTMLInputElement>('input[name="rating-5"]:checked');
      if (!selected?.value) {
        alert('Please select a rating.');
        return;
      }

      const ratingValue = parseFloat(selected.value);

      const statusDiv = document.getElementById('rating-status');
      if (statusDiv) {
        statusDiv.textContent = 'Submitting rating...';
        statusDiv.className = 'mt-2 text-info';
      }

      try {
        await pb.collection('ratings').create({
          article: articleId,
          rating:  ratingValue,
        });

        if (statusDiv) {
          statusDiv.textContent = 'Thank you for your rating!';
          statusDiv.className = 'mt-2 text-success';
        }

        setTimeout(() => location.reload(), 800);
      } catch (err: unknown) {
        console.error('Rating submission failed:', err);

        const errorMessage = err instanceof Error 
          ? err.message 
          : 'Unknown error occurred';

        if (statusDiv) {
          statusDiv.textContent = errorMessage.includes('403')
            ? 'Rating blocked – check PocketBase create rule'
            : `Error: ${errorMessage}`;
          statusDiv.className = 'mt-2 text-error';
        }
      }
    });
  }
</script>